# ─── 运行时目录（程序自动生成 / 用户数据，不入库）────────────────────────
# bin/ 内核二进制（CI 构建时下载）
bin/
# data/ 节点库 / settings.json / crash.log
data/
# run/ 内核运行目录（config.* / geodata / cache / rules）
run/
# configs/ 用户配置文件
configs/

# ─── 构建产物 ────────────────────────────────────────────────────────────
# wails build 输出
build/bin/
frontend/dist/
*.exe
*.zip
*.syso

# ─── 前端 ────────────────────────────────────────────────────────────────
frontend/node_modules/

# ─── 本地调试输出 ────────────────────────────────────────────────────────
output/

# ─── IDE / 系统 ──────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store
